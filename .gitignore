# ─── Secrets ──────────────────────────────────────────────────────────────
# backend/.env holds a live GEMINI_API_KEY. Never commit it.
.env
.env.*
!.env.example
*.key
*.pem

# ─── Source corpus ────────────────────────────────────────────────────────
# 682 MB of judgment PDFs, distributed separately. See README for how to
# obtain it and rebuild the index.
dataset/

# ─── Build output / derived data ──────────────────────────────────────────
# The search index (~21 MB) is generated from dataset/ by
# `python -m ingestion.build_index`. Code only in this repo.
backend/artifacts/
backend/eval/eval_set.json

# ─── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Node / Next.js ───────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.tsbuildinfo
next-env.d.ts
coverage/

# ─── Model / tool caches ──────────────────────────────────────────────────
.cache/
.huggingface/
transformers_cache/

# ─── Generated deliverables (regenerate with deck/build_deck.js) ──────────
deck/*.pptx
deck/*.pdf
deck/slide-*.jpg
deck/thumbnails*.jpg

# ─── Editor / OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ─── Scratch / backups ────────────────────────────────────────────────────
*.bak
*.preshadcn
*.log
tmp/
scratch/
